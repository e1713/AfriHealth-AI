# Server-side secrets and deployment configuration
APP_ENV=development
INTRON_API_KEY="<YOUR_EXISTING_INTRON_API_KEY>"
SAHARA_API_KEY="<YOUR_GENERATED_API_KEY_SECRET>"
INTRON_TTS_VOICE_LANGUAGE=am
INTRON_TTS_VOICE_ACCENT=amharic
INTRON_TTS_VOICE_GENDER=female
ALLOWED_ORIGINS=https://your-project.pages.dev
# Protect API routes with a generated bearer token; enter it in the browser when prompted.
# Optional FHIR transaction endpoint for a real EHR commit.
EHR_FHIR_ENDPOINT=
EHR_API_KEY=
# Railway provides DATABASE_URL for PostgreSQL; local development uses SQLite.
DATABASE_URL=sqlite+aiosqlite:///./edge_sync.sqlite3
# Optional clinic identifier forwarded by the browser stream client.
SAHARA_CLINIC_ID=default-clinic
# Optional live benchmark providers. Keys remain server-side.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
